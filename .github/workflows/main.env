
#!/usr/bin/env bash
set -euo pipefail

REPO="${1:-}"
if [[ -z "$REPO" ]]; then
  echo "Uso: bash create-betterui-pr.sh USUARIO/BetterUi"
  exit 1
fi

command -v git >/dev/null || { echo "Instale o Git primeiro."; exit 1; }
command -v gh >/dev/null || { echo "Instale o GitHub CLI (gh) primeiro."; exit 1; }
gh auth status >/dev/null || { echo "Faça login usando: gh auth login"; exit 1; }

WORKDIR="BetterUi"
BRANCH="feature/betterui-initial-project"

if [[ ! -d "$WORKDIR/.git" ]]; then
  gh repo clone "$REPO" "$WORKDIR"
fi

cd "$WORKDIR"
git switch -c "$BRANCH" 2>/dev/null || git switch "$BRANCH"

mkdir -p \
  plugins/betterui/js \
  plugins/betterui/assets/icons \
  scripts \
  .github/workflows

cat > README.md <<'EOF'
# BetterUi for Revenge

- Author: @huginpetur
- Plugin ID: dev.huginpetur.betterui
- Version: 0.3.0

BetterUi is a customization plugin project for the Revenge Android client.
It includes color themes, starter icon assets, validation and a GitHub Actions
workflow.

## Build and install

1. Check the Actions workflow and download its build artifact.
2. Install the compiled plugin ZIP through Revenge → Plugins →
   Advanced → Install from file.
3. Enable BetterUi and select a theme in Revenge → Themes.

This repository is source code, not a precompiled plugin release. Build
compatibility must be verified against the current official Revenge template
and on the target Discord/Revenge version.

## Development references

- https://github.com/revenge-mod/revenge-plugin-template
- https://revenge.palmdevs.me/docs/plugin-development/
EOF

cat > plugins/betterui/manifest.json <<'EOF'
{
  "format": 1,
  "id": "dev.huginpetur.betterui",
  "name": "BetterUi",
  "description": "Color themes and icon packs for Revenge.",
  "author": "@huginpetur",
  "version": "0.3.0",
  "dependencies": {
    "revenge.api": { "version": ">=1 <2" },
    "discord": { "version": "*" },
    "revenge.api.themes": {}
  },
  "dist": { "script": "index.js" }
}
EOF

cat > plugins/betterui/js/index.ts <<'EOF'
export default plugin({
  preInit({ themes }) {
    themes.registerGroup("betterui", {
      name: "BetterUi",
      description: "Color themes by @huginpetur"
    });

    themes.registerTheme("betterui", "midnight", {
      name: "BetterUi Midnight",
      description: "Charcoal surfaces with violet accents.",
      getColors: () => ({
        semantic: {
          dark: {
            BACKGROUND_BASE_LOWEST: "#101016",
            BACKGROUND_BASE_LOWER: "#15151D",
            BACKGROUND_BASE: "#1A1A24",
            BACKGROUND_BASE_HIGH: "#232331",
            TEXT_DEFAULT: "#F4F2FA",
            TEXT_MUTED: "#B5B1C5"
          }
        },
        raw: {
          BRAND_500: "#9B8CFF",
          BRAND_560: "#8473F0"
        }
      })
    });

    themes.registerTheme("betterui", "ocean", {
      name: "Ocean Glass",
      description: "Dark navy with cyan accents.",
      getColors: () => ({
        semantic: {
          dark: {
            BACKGROUND_BASE_LOWEST: "#08131A",
            BACKGROUND_BASE_LOWER: "#0D1B24",
            BACKGROUND_BASE: "#12232E",
            BACKGROUND_BASE_HIGH: "#1A303D",
            TEXT_DEFAULT: "#EAF7FC",
            TEXT_MUTED: "#A6C4D0"
          }
        },
        raw: {
          BRAND_500: "#5BD5E8",
          BRAND_560: "#32BFD5"
        }
      })
    });
  },

  start({ logger }) {
    logger.log("BetterUi enabled. Author: @huginpetur");
  }
});
EOF

cat > scripts/validate.py <<'EOF'
import json
from pathlib import Path

p = Path("plugins/betterui/manifest.json")
data = json.loads(p.read_text(encoding="utf-8"))

assert data["format"] == 1
assert data["id"] == "dev.huginpetur.betterui"
assert data["author"] == "@huginpetur"
assert data["version"] == "0.3.0"
assert Path("plugins/betterui/js/index.ts").is_file()

print("BetterUi manifest and source structure validated.")
EOF

cat > .github/workflows/validate.yml <<'EOF'
name: Validate BetterUi source

on:
  push:
    branches: [main, master, "feature/**"]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.x"
      - name: Validate manifest and source
        run: python scripts/validate.py
EOF

python3 scripts/validate.py

git add README.md plugins scripts .github
git commit -m "Add BetterUi plugin starter and validation workflow"
git push -u origin "$BRANCH"

gh pr create \
  --repo "$REPO" \
  --base main \
  --head "$BRANCH" \
  --title "Add BetterUi plugin starter" \
  --body "Adds the BetterUi plugin manifest, initial color themes, source validation, and GitHub Actions workflow. Compatibility and runtime behavior still require build and device testing."

echo "Pull Request created. Open the URL printed above."
